<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <UserConfigurations>
        <ColorConfiguration id="theme_color" displayName="theme_color_name" defaultValue="0">
            <ColorOption id="0" displayName="theme_sport" colors="#ff00e5ff #ff14f195 #ffff6b00" />
            <ColorOption id="1" displayName="theme_arctic" colors="#ff38d6ff #fff8fafc #ff7dd3fc" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff05070b">
        <PartDraw x="16" y="16" width="418" height="418">
            <Variant mode="AMBIENT" target="alpha" value="35" />
            <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="318">
                <Stroke color="#ff151e2c" thickness="10" cap="ROUND" />
            </Arc>
            <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="144">
                <Stroke color="#ff151e2c" thickness="10" cap="ROUND" />
            </Arc>
        </PartDraw>

        <ComplicationSlot x="16" y="16" width="418" height="418" slotId="1"
            name="slot_xp" displayName="slot_xp_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="209" centerY="209" width="402" height="402" thickness="26"
                startAngle="216" endAngle="318" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkLevelXpComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="418" height="418" alpha="55">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="318">
                        <Transform target="endAngle" value="216 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="26" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418" alpha="120">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="318">
                        <Transform target="endAngle" value="216 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="17" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418">
                    <Variant mode="AMBIENT" target="alpha" value="105" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="318">
                        <Transform target="endAngle" value="216 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418" alpha="175">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="318">
                        <Transform target="endAngle" value="216 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="#ffffffff" thickness="3" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="418" height="418">
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="216" endAngle="294">
                        <Stroke color="[CONFIGURATION.theme_color.0]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot x="16" y="16" width="418" height="418" slotId="2"
            name="slot_kcal" displayName="slot_kcal_name"
            isCustomizable="true" supportedTypes="RANGED_VALUE SHORT_TEXT">
            <BoundingArc centerX="209" centerY="209" width="402" height="402" thickness="26"
                startAngle="42" endAngle="144" isClockwise="true" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkKcalComplicationService"
                primaryProviderType="RANGED_VALUE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="418" height="418" alpha="55">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="144">
                        <Transform target="endAngle" value="42 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="26" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418" alpha="120">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="144">
                        <Transform target="endAngle" value="42 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="17" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418">
                    <Variant mode="AMBIENT" target="alpha" value="105" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="144">
                        <Transform target="endAngle" value="42 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="0" y="0" width="418" height="418" alpha="175">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="144">
                        <Transform target="endAngle" value="42 + 102 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / max(1, [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0.16, 1)" />
                        <Stroke color="#ffffffff" thickness="3" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="418" height="418">
                    <Arc centerX="209" centerY="209" width="402" height="402" startAngle="42" endAngle="120">
                        <Stroke color="[CONFIGURATION.theme_color.1]" thickness="10" cap="ROUND" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <PartImage x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="65" />
            <Image resource="dial_chassis_status" />
        </PartImage>

        <PartText x="115" y="48" width="220" height="24">
            <Variant mode="AMBIENT" target="alpha" value="130" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#ffb0c4de">
                    <Template>%s %s.%s • %s%%<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /><Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <PartText x="52" y="76" width="160" height="90">
            <Text align="END">
                <Font family="SYNC_TO_DEVICE" size="82" weight="BOLD" color="#ffffffff">
                    <Template>%s<Parameter expression="[HOUR_0_23_Z]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartDraw x="214" y="84" width="22" height="74" alpha="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="22" height="74" cornerRadiusX="11" cornerRadiusY="11">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="218" y="88" width="14" height="66" alpha="110">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="14" height="66" cornerRadiusX="7" cornerRadiusY="7">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="222" y="91" width="6" height="60">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <RoundRectangle x="0" y="0" width="6" height="60" cornerRadiusX="3" cornerRadiusY="3">
                <Fill color="[CONFIGURATION.theme_color.0]" />
            </RoundRectangle>
        </PartDraw>
        <PartDraw x="224" y="95" width="2" height="52" alpha="210">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="2" height="52" cornerRadiusX="1" cornerRadiusY="1">
                <Fill color="#ffffffff" />
            </RoundRectangle>
        </PartDraw>
        <PartText x="236" y="76" width="126" height="90">
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="82" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                    <Template>%s<Parameter expression="[MINUTE_Z]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="346" y="128" width="42" height="26">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffb0c4de">
                    <Template>%s<Parameter expression="[SECOND_Z]" /></Template>
                </Font>
            </Text>
        </PartText>

        <ComplicationSlot x="115" y="177" width="220" height="30" slotId="3"
            name="slot_rank" displayName="slot_rank_name"
            isCustomizable="true" supportedTypes="SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="220" height="30" cornerRadius="15" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkRankFullComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="3" width="220" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="[CONFIGURATION.theme_color.0]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot x="84" y="222" width="282" height="124" slotId="4"
            name="slot_bars" displayName="slot_bars_name"
            isCustomizable="true" supportedTypes="SMALL_IMAGE SHORT_TEXT">
            <BoundingRoundBox x="0" y="0" width="282" height="124" cornerRadius="18" />
            <DefaultProviderPolicy
                primaryProvider="eu.remk.coaching.wear/eu.remk.coaching.wear.RemkStatusBarsImageComplicationService"
                primaryProviderType="SMALL_IMAGE"
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="282" height="124">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartImage x="0" y="0" width="282" height="124">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Image resource="fallback_bars" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <PartText x="174" y="362" width="160" height="26">
            <Variant mode="AMBIENT" target="alpha" value="120" />
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#ffdae6f5">
                    <Template>%s BPM • %s<Parameter expression="[HEART_RATE]" /><Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- TOP-MOST DOMED SAPPHIRE CRYSTAL GLASS LAYER -->
        <PartImage x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="sapphire_glass_overlay" />
        </PartImage>
    </Scene>
</WatchFace>
